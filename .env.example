# Firebase Realtime Database configuration (Vite exposes VITE_* to the client).
# Create a Firebase project, add a Realtime Database, then copy this file to .env
# and fill in the values from Project settings → General → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
